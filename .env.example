# Docker Compose database settings
POSTGRES_DB=cinestack
POSTGRES_USER=cinestack
POSTGRES_PASSWORD=cinestack
# Port on your machine for the database. Change it if 5432 is already in use.
POSTGRES_HOST_PORT=5432

# Application settings
# Set to "prod" on a public deployment: it requires a private JWT_SECRET, turns off the
# API docs and reads visitor addresses from the hosting proxy. Leave empty locally.
SPRING_PROFILES_ACTIVE=
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# How long a login lasts, in minutes (10080 = 7 days).
JWT_EXPIRATION_MINUTES=10080
TMDB_API_KEY=replace-with-your-tmdb-api-key
TMDB_REQUEST_MIN_INTERVAL_MS=250
TMDB_REQUEST_MAX_WAIT_MS=2000
TMDB_CACHE_REFRESH_DAYS=30
TMDB_CACHE_MAX_AGE_DAYS=175
TMDB_PURGE_ON_STARTUP=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
